{
  "name": "vertex",
  "version": "0.0.1",
  "description": "The IDE that lives in a browser tab — clone any GitHub repo, then edit, build, preview and deploy it with zero install.",
  "author": "Andrii Pap",
  "license": "MIT",
  "keywords": [
    "ide",
    "web-ide",
    "browser-ide",
    "code-editor",
    "codemirror",
    "angular",
    "analogjs",
    "tauri",
    "bun",
    "rust",
    "monorepo",
    "webcontainers",
    "isomorphic-git",
    "opfs",
    "esbuild"
  ],
  "homepage": "https://vertex.andersseen.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Andersseen/vertex.git"
  },
  "bugs": {
    "url": "https://github.com/Andersseen/vertex/issues"
  },
  "scripts": {
    "build": "turbo run build --concurrency=2",
    "web-editor:build": "cd packages/frontend/web-editor && bun run build",
    "web-editor:serve": "bun run web-editor:build && bun packages/frontend/web-editor/server.ts",
    "web-editor-demo:dev": "cd apps/web-editor-demo && bun run dev",
    "web-editor-demo:build": "cd apps/web-editor-demo && bun run build",
    "web-editor-demo:start": "bun run web-editor:build && cd apps/web-editor-demo && bun run dev",
    "dev": "turbo run dev",
    "dev:web-editor": "cd packages/frontend/web-editor && bun run watch",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "typecheck": "turbo run check-types",
    "test": "bun test",
    "test:e2e": "cd apps/web && bun run test:e2e",
    "test:e2e:ui": "cd apps/web && bun run test:e2e:ui",
    "web:dev": "cd apps/web && bun run start",
    "web:build": "cd apps/web && bun run build",
    "web:test": "cd apps/web && bun run test",
    "deploy": "bun run web:deploy",
    "web:deploy": "cd apps/web && bun run deploy",
    "desktop:dev": "cd apps/desktop && source ~/.cargo/env && bun run tauri:dev",
    "desktop:build": "cd apps/desktop && source ~/.cargo/env && bun run tauri:build",
    "desktop:build:debug": "cd apps/desktop && source ~/.cargo/env && bun run tauri:build --debug",
    "desktop:build:release": "cd apps/desktop && source ~/.cargo/env && bun run tauri:build",
    "sidecar:dev": "cd packages/backend/sidecar && bun run dev",
    "sidecar:build": "cd packages/backend/sidecar && bun run build",
    "terminal:install": "cd packages/backend/terminal && npm install",
    "terminal:dev": "WORKSPACE_PATH=$(pwd) node packages/backend/terminal/index.js",
    "terminal:build": "cd packages/backend/terminal && npm run build",
    "dev:all": "concurrently \"bun sidecar:dev\" \"bun terminal:dev\" \"bun web:dev\"",
    "dev:desktop": "concurrently \"bun sidecar:dev\" \"bun terminal:dev\" \"bun desktop:dev\""
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "concurrently": "^9.1.0",
    "eslint": "^10.1.0",
    "prettier": "^3.7.4",
    "rxjs": "~7.8.0",
    "turbo": "^2.8.20",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.57.2"
  },
  "bin": {
    "vertex": "./packages/frontend/web-editor/bin/install.mjs",
    "vertex-editor": "./packages/frontend/web-editor/bin/install.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/frontend/*",
    "packages/backend/*"
  ],
  "module": "index.ts",
  "type": "module",
  "dependencies": {
    "@andersseen/headless-components": "^0.1.1",
    "@angular/animations": "^21.2.5",
    "@angular/common": "^21.2.5",
    "@angular/compiler": "^21.2.5",
    "@angular/core": "^21.2.5",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.5",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "dexie": "^4.4.2",
    "esbuild-wasm": "^0.28.0",
    "hono": "^4.12.9",
    "node-pty": "^1.1.0"
  }
}
