{
  "name": "vertex",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "typecheck": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "cd apps/web && bun run test:e2e",
    "test:e2e:ui": "cd apps/web && bun run test:e2e:ui",
    "web:dev": "cd apps/web && bun run start",
    "web:build": "cd apps/web && bun run build",
    "web:test": "cd apps/web && bun run test",
    "web:deploy": "cd apps/web && bun run deploy",
    "desktop:dev": "cd apps/desktop && source ~/.cargo/env && bun run tauri:dev",
    "desktop:build": "cd apps/desktop && source ~/.cargo/env && bun run tauri:build",
    "desktop:build:debug": "cd apps/desktop && source ~/.cargo/env && bun run tauri:build --debug",
    "desktop:build:release": "cd apps/desktop && source ~/.cargo/env && bun run tauri:build",
    "sidecar:dev": "cd packages/backend/sidecar && bun run dev",
    "sidecar:build": "cd packages/backend/sidecar && bun run build",
    "package:desktop": "bun sidecar:build && bun desktop:build:release",
    "package:desktop:debug": "bun sidecar:build && bun desktop:build:debug",
    "dev:all": "concurrently \"bun sidecar:dev\" \"bun web:dev\"",
    "dev:desktop": "concurrently \"bun sidecar:dev\" \"bun desktop:dev\""
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^21.3.1",
    "@angular-eslint/template-parser": "^21.3.1",
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "concurrently": "^9.1.0",
    "eslint": "^10.1.0",
    "prettier": "^3.7.4",
    "turbo": "^2.8.20",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.57.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/frontend/*",
    "packages/backend/*"
  ],
  "module": "index.ts",
  "type": "module",
  "dependencies": {
    "@angular/animations": "^21.2.5"
  }
}
