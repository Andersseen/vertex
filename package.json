{
  "name": "vertex",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "ui:dev": "cd apps/vertex-ui && bun run start",
    "ui:build": "cd apps/vertex-ui && bun run build",
    "tauri:dev": "cd apps/vertex-ui && source ~/.cargo/env && bun run tauri dev",
    "sidecar:dev": "cd packages/vertex-sidecar && bun run dev",
    "sidecar:build": "cd packages/vertex-sidecar && bun run build",
    "app:dev": "bunx turbo run tauri:dev",
    "dev:all": "concurrently \"bun sidecar:dev\" \"bun tauri:dev\""
  },
  "devDependencies": {
    "@types/bun": "latest",
    "concurrently": "^9.1.0",
    "prettier": "^3.7.4",
    "turbo": "^2.8.20",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "module": "index.ts",
  "type": "module"
}
