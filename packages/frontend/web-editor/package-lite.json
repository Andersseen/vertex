{
  "name": "@vertex/web-editor-lite",
  "description": "Lightweight code editor web component - read-only display optimized",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/web-editor-lite.min.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@angular/core": "^21.2.0",
    "@angular/elements": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.0",
    "@angular/cli": "^21.2.0",
    "@angular/compiler-cli": "^21.2.0",
    "typescript": "~5.8.3"
  },
  "scripts": {
    "build:lite": "ng build --configuration=production-lite"
  }
}

/**
 * DIFFERENCE FROM FULL VERSION:
 * 
 * REMOVED packages (~150KB+ savings):
 * - @codemirror/autocomplete - Not needed for read-only
 * - @codemirror/search - Not needed for read-only
 * - @codemirror/lang-markdown - Less common for code display
 * 
 * REMOVED from bundle:
 * - All markdown parsing
 * - All search functionality
 * - All autocomplete
 * - attribute-observer polling
 */
