{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "web-editor": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "vertex",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist-lite",
            "index": "src/index.html",
            "browser": "src/main-lite.ts",
            "polyfills": [],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              "src/favicon.ico",
              "src/assets"
            ],
            "styles": [],
            "scripts": [],
            "stylePreprocessorOptions": {
              "includePaths": ["node_modules"]
            }
          },
          "configurations": {
            "production-lite": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "800kb",
                  "maximumError": "1mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kb",
                  "maximumError": "8kb"
                }
              ],
              "outputHashing": "none",
              "optimization": {
                "scripts": true,
                "styles": true,
                "fonts": true
              },
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": false,
              "statsJson": false,
              "ssr": false,
              "prerender": false,
              "outputMode": "single",
              "entryPoints": {
                "web-editor-lite": "src/main-lite.ts"
              },
              "outputEntryNaming": "[name].min.js",
              "outputChunkNaming": "[name].js",
              "outputCSSNaming": "[name].css"
            }
          },
          "defaultConfiguration": "production-lite"
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
