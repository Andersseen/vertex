{
  "name": "@vertex/web-editor",
  "version": "0.1.0",
  "description": "A lightweight, standalone code editor Web Component built with Angular Elements and CodeMirror 6",
  "main": "dist/web-editor.js",
  "module": "dist/web-editor.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vertex-editor": "./bin/install.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "bun run clean && bun run compile && bun run bundle",
    "build:lite": "bun run clean && bun run compile:lite && bun run bundle:lite",
    "clean": "rm -rf dist",
    "compile": "tsc --project tsconfig.build.json",
    "compile:lite": "tsc --project tsconfig.build-lite.json",
    "bundle": "bun run bundle:main && bun run bundle:min",
    "bundle:main": "esbuild dist/main.js --bundle --outfile=dist/web-editor.js --format=iife --global-name=WebEditor --sourcemap --platform=browser --external:fs --external:path --external:os",
    "bundle:min": "esbuild dist/main.js --bundle --outfile=dist/web-editor.min.js --format=iife --global-name=WebEditor --minify --sourcemap --platform=browser --external:fs --external:path --external:os",
    "bundle:lite": "esbuild dist/main-lite.js --bundle --outfile=dist/web-editor-lite.min.js --format=iife --global-name=WebEditor --minify --sourcemap --platform=browser --external:fs --external:path --external:os --define:process.env.NODE_ENV='\"production\"'",
    "watch": "bun run build && chokidar 'src/**/*.ts' -c 'bun run build'",
    "lint": "eslint src",
    "check-types": "tsc --noEmit",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "web-component",
    "editor",
    "codemirror",
    "angular-elements",
    "typescript",
    "javascript",
    "html",
    "css",
    "json",
    "markdown",
    "code-editor",
    "syntax-highlighting",
    "standalone",
    "vanilla-js",
    "react",
    "vue",
    "astro",
    "angular"
  ],
  "author": "Andrii Pap",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/vertex-editor.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/vertex-editor/issues"
  },
  "homepage": "https://github.com/your-username/vertex-editor#readme",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/elements": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/compiler-cli": "^21.2.0",
    "@types/node": "^20.0.0",
    "chokidar": "^4.0.0",
    "chokidar-cli": "^3.0.0",
    "esbuild": "^0.25.0",
    "typescript": "~5.9.2"
  }
}
