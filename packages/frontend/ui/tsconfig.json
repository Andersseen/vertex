{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@vertex/types": ["../types/src/index.ts"],
      "@vertex/core": ["../core/src/index.ts"],
      "@vertex/runtime": ["../runtime/src/index.ts"],
      "@vertex/runtime/lsp": ["../runtime/src/lsp/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.test.ts", "**/*.spec.ts", "dist", "node_modules"]
}
