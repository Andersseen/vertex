{
  "name": "@vertex/runtime",
  "version": "0.1.0",
  "description": "Browser-native runtime: VirtualFS, Git, Build, WebContainers preview, Deploy",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./fs": {
      "types": "./src/fs/index.ts",
      "import": "./dist/fs/index.js"
    },
    "./git": {
      "types": "./src/git/index.ts",
      "import": "./dist/git/index.js"
    },
    "./build": {
      "types": "./src/build/index.ts",
      "import": "./dist/build/index.js"
    },
    "./preview-wc-headless": {
      "types": "./src/preview-wc-headless/index.ts",
      "import": "./dist/preview-wc-headless/index.js"
    },
    "./preview-wc": {
      "types": "./src/preview-wc/index.ts",
      "import": "./dist/preview-wc/index.js"
    },
    "./deploy": {
      "types": "./src/deploy/index.ts",
      "import": "./dist/deploy/index.js"
    },
    "./types-checker": {
      "types": "./src/extras/types/index.ts",
      "import": "./dist/extras/types/index.js"
    },
    "./lint": {
      "types": "./src/extras/lint/index.ts",
      "import": "./dist/extras/lint/index.js"
    },
    "./format": {
      "types": "./src/extras/format/index.ts",
      "import": "./dist/extras/format/index.js"
    },
    "./css": {
      "types": "./src/extras/css/index.ts",
      "import": "./dist/extras/css/index.js"
    },
    "./lsp": {
      "types": "./src/lsp/index.ts",
      "import": "./dist/lsp/index.js"
    },
    "./plugins": {
      "types": "./src/plugins/index.ts",
      "import": "./dist/plugins/index.js"
    },
    "./plugins/examples": {
      "types": "./src/plugins/examples/index.ts",
      "import": "./dist/plugins/examples/index.js"
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "bun build.ts",
    "build:watch": "tsc --project tsconfig.json --watch",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "prepare": "bun run build",
    "prepublishOnly": "bun run build"
  },
  "keywords": ["browser-runtime", "virtual-fs", "git", "webcontainer", "webcontainers", "ide", "preview"],
  "author": "Andrii Pap",
  "license": "MIT",
  "dependencies": {
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "@webcontainer/api": "^1.6.4",
    "esbuild-wasm": "^0.28.0",
    "isomorphic-git": "^1.37.5",
    "typescript": "~5.9.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0",
    "eslint": ">=9.0.0",
    "prettier": ">=3.0.0",
    "postcss": ">=8.0.0",
    "sass": ">=1.70.0"
  },
  "peerDependenciesMeta": {
    "eslint": { "optional": true },
    "prettier": { "optional": true },
    "postcss": { "optional": true },
    "sass": { "optional": true }
  }
}
