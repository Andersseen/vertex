{
  "name": "@vertex/runtime",
  "version": "0.1.0",
  "description": "Browser-native runtime: VirtualFS, Git, Build, Preview, Deploy",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./fs": {
      "import": "./src/fs/index.ts",
      "types": "./src/fs/index.ts"
    },
    "./git": {
      "import": "./src/git/index.ts",
      "types": "./src/git/index.ts"
    },
    "./build": {
      "import": "./src/build/index.ts",
      "types": "./src/build/index.ts"
    },
    "./preview-lite": {
      "import": "./src/preview-lite/index.ts",
      "types": "./src/preview-lite/index.ts"
    },
    "./preview-node": {
      "import": "./src/preview-node/index.ts",
      "types": "./src/preview-node/index.ts"
    },
    "./node": {
      "import": "./src/node/index.ts",
      "types": "./src/node/index.ts"
    },
    "./deploy": {
      "import": "./src/deploy/index.ts",
      "types": "./src/deploy/index.ts"
    },
    "./types-checker": {
      "import": "./src/extras/types/index.ts",
      "types": "./src/extras/types/index.ts"
    },
    "./lint": {
      "import": "./src/extras/lint/index.ts",
      "types": "./src/extras/lint/index.ts"
    },
    "./format": {
      "import": "./src/extras/format/index.ts",
      "types": "./src/extras/format/index.ts"
    },
    "./css": {
      "import": "./src/extras/css/index.ts",
      "types": "./src/extras/css/index.ts"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": ["browser-runtime", "virtual-fs", "git", "webcontainer", "ide"],
  "author": "Andrii Pap",
  "license": "MIT",
  "dependencies": {
    "@codesandbox/nodebox": "^0.1.9",
    "@isomorphic-git/lightning-fs": "^4.6.2",
    "esbuild-wasm": "^0.28.0",
    "isomorphic-git": "^1.37.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "~5.9.2"
  },
  "peerDependencies": {
    "typescript": ">=5.0",
    "eslint": ">=9.0.0",
    "prettier": ">=3.0.0",
    "postcss": ">=8.0.0",
    "sass": ">=1.70.0"
  },
  "peerDependenciesMeta": {
    "eslint": { "optional": true },
    "prettier": { "optional": true },
    "postcss": { "optional": true },
    "sass": { "optional": true }
  }
}
