{
  "name": "@vertex/ide-ui",
  "version": "0.1.0",
  "description": "Vertex IDE - Custom UI components built on @andersseen/headless-components",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./styles": {
      "import": "./src/styles/index.scss"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@andersseen/headless-components": "^0.1.1",
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@vertex/types": "workspace:*",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.2"
  },
  "peerDependencies": {
    "@angular/common": "^21.2.0",
    "@angular/core": "^21.2.0"
  },
  "devDependencies": {
    "typescript": "~5.9.2"
  }
}
