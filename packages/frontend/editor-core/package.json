{
  "name": "@vertex/editor-core",
  "version": "0.1.0",
  "description": "Framework-agnostic CodeMirror engine shared by Vertex editor surfaces",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./languages/web": {
      "import": "./src/languages/web.ts",
      "types": "./src/languages/web.ts"
    },
    "./languages/workbench": {
      "import": "./src/languages/workbench.ts",
      "types": "./src/languages/workbench.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bun test"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.40.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "~5.9.2"
