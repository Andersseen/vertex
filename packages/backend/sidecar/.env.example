# Vertex Sidecar Configuration
# Copy this file to .env and configure for your environment

# Server Configuration
SIDECAR_PORT=3001

# Security: Workspace Path
# The absolute path that serves as the root for all file operations
# All paths outside this directory will be rejected
# Default: current working directory
WORKSPACE_PATH=/path/to/your/workspace

# Security: File Size Limits
# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE=10485760

# Security: Rate Limiting
# Maximum requests per window (default: 100)
RATE_LIMIT_REQ=100
# Window size in seconds (default: 60)
RATE_LIMIT_WINDOW=60

# Security: CORS Origins
# Comma-separated list of allowed origins
# Note: Desktop Tauri runs on port 4201 by default
# Default: http://localhost:4200,http://localhost:4201,http://localhost:1420
CORS_ORIGIN=http://localhost:4200,http://localhost:4201,http://localhost:1420

# Example for production:
# CORS_ORIGIN=https://vertex.example.com,https://app.vertex.example.com

# Note: Never commit .env file with real values to version control!
